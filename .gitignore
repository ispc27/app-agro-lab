# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Local Credentials & Secrets (Security Best Practice)
config.yaml
!config.example.yaml
.streamlit/secrets.toml

# Data & Large Files (Security & Repo size)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Virtual environments
venv/
.venv/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS specific
.DS_Store
Thumbs.db
